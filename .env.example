# =============================================
# LensPilot AI Assistant - Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# =============================================

# --- Server ---
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# --- API ---
API_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lenspilot_ai

# --- AI / LLM (Gemini -- free tier, no card required) ---
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
CHAT_MODEL=gemini-2.5-flash

# --- Authentication ---
API_KEY=
JWT_SECRET=your-jwt-secret-here

# --- Ingestion ---
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=30
RETRIEVAL_TOP_K=5
INGESTION_DOCS_DIR=backend/ingestion/knowledge_base

# --- Widget ---
WIDGET_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
LOG_LEVEL=info

# --- Security / Operations ---
RATE_LIMIT_PER_MINUTE=30

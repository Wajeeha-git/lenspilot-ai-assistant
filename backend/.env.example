ENV=development
API_PREFIX=/api/v1

# Optional simple auth for /chat and /ingest -- leave blank to disable.
# Accepted as either x-api-key: <key> or Authorization: Bearer <key>.
API_KEY=

# Comma-separated list, or * for any origin (dev only)
CORS_ORIGINS=*

# Postgres (must have the pgvector extension enabled)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lenspilot_ai

# Gemini (free tier, no card required) -- get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
CHAT_MODEL=gemini-2.5-flash

# RAG tuning
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=30
RETRIEVAL_TOP_K=5

# Security / operations
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
